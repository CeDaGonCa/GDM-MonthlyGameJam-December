  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 168274c69305a0c4c85eed3c6055ab30, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroSceneManager
  lettersPerSecond: 15
  pauseInLineBreak: 0.5
  fadeTime: 0.5
  Scenes:
  - lines:
    - I recently got fired from my job
    - "Despite being a heart surgeon and applying to every hospital in my area\u2026"
    - "I only got one response. \nSeriously, what the hell is wrong with the job market right now?"
    background: {fileID: 21300000, guid: 50f1c4b4a222bdb44be77e2dc6e9d24a, type: 3}
    isSpoken: 0
    dialogOrder: []
  - lines:
    - They agreed to hire me right away, no questions asked, which is pretty sketchy.
    - "But I need the money, so it\u2019s fine."
    background: {fileID: 21300000, guid: 83d69e1509dc28e469c71fabc6c03101, type: 3}
    isSpoken: 0
    dialogOrder: []
  - lines:
    - Today is the day I officially start.
    - At the very least, I hope my coworkers are nice.
    background: {fileID: 21300000, guid: 8f405e35c39fb074aa962a41119c22ca, type: 3}
    isSpoken: 0
    dialogOrder: []
  - lines:
    - "???: \u201CYou\u2019re two minutes late.\u201D"
    - "You: \u201CHuh? Ah, sorry\u2013\u201D"
    - "???: \u201CThere\u2019s a patient in room six. Let\u2019s go.\u201D"
    - "You: \u201CRight\u2026okay\u2026\u201D"
    background: {fileID: 8666664153384852542, guid: 585e255068b50814699fb2ba12059d06, type: 3}
    isSpoken: 1
    dialogOrder:
    - ???
    - You
    - ???
    - You
  background: {fileID: 2018310873}
